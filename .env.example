# =====================================================
# Alazab Nexus — Local Development Environment
# Copy to `.env` and fill values. Never commit `.env`.
# =====================================================

# --- Supabase (Lovable Cloud) ---
# Client (browser) — publishable/anon key is safe to expose
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server (SSR + server functions + edge routes)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- API security ---
# Comma-separated origins allowed for CORS on /api/* routes.
# Leave empty in development → wildcard is used automatically.
ALLOWED_ORIGINS=
# Per-consumer per-minute rate limit on public/private API endpoints
API_RATE_LIMIT_PER_MINUTE=120

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=

# --- Azure AI Foundry Agents ---
# Server-only key for az-agent-prod. This must never be exposed through VITE_*.
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_AGENT_ENDPOINT=https://az-ai-resource.services.ai.azure.com/api/projects/az-ai-gateway/agents/az-agent-prod/endpoint/protocols/openai/responses

# --- Runtime ---
NODE_ENV=development
